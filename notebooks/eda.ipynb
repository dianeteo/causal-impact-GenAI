    "\n",
    "\n",
    "def prepare_unique_postings(\n",
    "    df: pd.DataFrame,\n",
    "    date_col: str = \"post_date\",\n",
    "    hash_col: str = \"content_hash\",\n",
    "    hash_cols=None,\n",
    "    keep: str = \"first\",\n",
    "    window_days: int = 60,\n",
    "):\n",
    "    \"\"\"\n",
    "    Returns a repost-cleaned dataframe using a rolling-window rule:\n",
    "      - Same content_hash reposted within `window_days` is treated as a repost\n",
    "      - Keep the first (or last) post within each 60-day episode\n",
    "      - If the same hash reappears after > window_days, keep it as a new episode\n",
    "\n",
    "    Adds:\n",
    "      - quarter (Period)\n",
    "    \"\"\"\n",
    "    if keep not in (\"first\", \"last\"):\n",
    "        raise ValueError(\"keep must be 'first' or 'last'.\")\n",
    "\n",
    "    d = df.copy()\n",
    "\n",
    "    # Ensure datetime\n",
    "    d[date_col] = pd.to_datetime(d[date_col], errors=\"coerce\")\n",
    "    d = d.dropna(subset=[date_col])\n",
    "\n",
    "    # Ensure content hash\n",
    "    d = _ensure_content_hash(d, hash_cols=hash_cols, hash_colname=hash_col)\n",
    "\n",
    "    # Windowed repost removal (same logic as above)\n",
    "    d_unique = _dedupe_within_window(\n",
    "        d,\n",
    "        date_col=date_col,\n",
    "        hash_col=hash_col,\n",
    "        window_days=window_days,\n",
    "        keep=keep,\n",
    "    ).copy()\n",
    "\n",
    "    # Add quarter\n",
    "    d_unique[\"quarter\"] = d_unique[date_col].dt.to_period(\"Q\")\n",
    "\n",
    "    return d_unique"
   ]
  },
