  {
   "cell_type": "markdown",
   "id": "3458423f",
   "metadata": {},
   "source": [
    "### Saving postings without reposts (2022-2024)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "f0f981b8",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import hashlib\n",
    "\n",
    "def _ensure_content_hash(\n",
    "    df: pd.DataFrame,\n",
    "    hash_cols=None,\n",
    "    hash_colname: str = \"content_hash\"\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Ensure df has a stable 'content_hash' column.\n",
    "    If already present, keep it. Otherwise create from selected columns.\n",
    "    \"\"\"\n",
    "    df = df.copy()\n",
    "\n",
    "    if hash_colname in df.columns and df[hash_colname].notna().any():\n",
    "        return df\n",
    "\n",
    "    if hash_cols is None:\n",
    "        hash_cols = [\n",
    "            \"ultimate_parent_rcid\",\n",
    "            \"ultimate_parent_company_name\",\n",
    "            \"company\",\n",
    "            \"mapped_role\",\n",
    "            \"onet_code\",\n",
    "            \"jobtitle\",\n",
    "            \"title_raw\",\n",
    "            \"title_translated\",\n",
    "            \"location_raw\",\n",
    "            \"remote_type\",\n",
    "            \"description\",\n",
    "            \"salary_min\",\n",
    "            \"salary_max\",\n",
    "            \"salary_predicted\",\n",
    "        ]\n",
    "\n",
    "    hash_cols = [c for c in hash_cols if c in df.columns]\n",
    "    if not hash_cols:\n",
    "        raise ValueError(\"No valid hash columns found in df to build content_hash.\")\n",
    "\n",
    "    def norm(x):\n",
    "        if pd.isna(x):\n",
    "            return \"\"\n",
    "        s = str(x).strip().lower()\n",
    "        return \" \".join(s.split())\n",
    "\n",
    "    def make_hash(row):\n",
    "        s = \"||\".join(norm(v) for v in row.values)\n",
    "        return hashlib.md5(s.encode(\"utf-8\")).hexdigest()\n",
    "\n",
    "    df[hash_colname] = df[hash_cols].apply(make_hash, axis=1)\n",
    "    return df\n",
    "\n",
    "def _dedupe_within_window(\n",
    "    d: pd.DataFrame,\n",
    "    date_col: str,\n",
    "    hash_col: str,\n",
    "    window_days: int = 60,\n",
    "    keep: str = \"first\",\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Rolling-window repost removal.\n",
    "\n",
    "    For each content_hash:\n",
    "      - sort by post_date\n",
    "      - start a new 'episode' if the gap to the previous post > window_days\n",
    "      - keep the first (or last) post within each episode\n",
    "    \"\"\"\n",
    "    if keep not in (\"first\", \"last\"):\n",
    "        raise ValueError(\"keep must be 'first' or 'last'.\")\n",
    "\n",
    "    dd = d.sort_values([hash_col, date_col]).copy()\n",
    "\n",
    "    dd[\"prev_date\"] = dd.groupby(hash_col)[date_col].shift(1)\n",
    "    dd[\"gap_days\"] = (dd[date_col] - dd[\"prev_date\"]).dt.days\n",
    "\n",
    "    dd[\"new_episode\"] = dd[\"prev_date\"].isna() | (dd[\"gap_days\"] > window_days)\n",
    "    dd[\"episode_id\"] = dd.groupby(hash_col)[\"new_episode\"].cumsum()\n",
    "\n",
    "    if keep == \"first\":\n",
    "        out = dd.drop_duplicates(subset=[hash_col, \"episode_id\"], keep=\"first\")\n",
    "    else:\n",
    "        out = dd.drop_duplicates(subset=[hash_col, \"episode_id\"], keep=\"last\")\n",
    "\n",
    "    return out.drop(columns=[\"prev_date\", \"gap_days\", \"new_episode\", \"episode_id\"])\n",
    "\n",
    "def save_yearly_without_reposts_windowed(\n",
    "    df: pd.DataFrame,\n",
    "    years,\n",
    "    out_dir: str = \"../data/Postings\",\n",
    "    country_prefix: str = \"SG\",\n",
    "    date_col: str = \"post_date\",\n",
    "    hash_col: str = \"content_hash\",\n",
    "    hash_cols=None,\n",
    "    window_days: int = 60,\n",
    "    keep: str = \"first\",\n",
    "    parquet_kwargs=None,\n",
    "):\n",
    "    \"\"\"\n",
    "    Save one file per year after removing reposts using a rolling window.\n",
    "\n",
    "    Output filenames:\n",
    "      {country_prefix}-{year}-WITHOUT-REPOSTS-W{window_days}D.parquet\n",
    "    \"\"\"\n",
    "    os.makedirs(out_dir, exist_ok=True)\n",
    "    parquet_kwargs = parquet_kwargs or {}\n",
    "\n",
    "    d = df.copy()\n",
    "\n",
    "    # Ensure datetime once\n",
    "    d[date_col] = pd.to_datetime(d[date_col], errors=\"coerce\")\n",
    "    d = d.dropna(subset=[date_col])\n",
    "\n",
    "    # Ensure content hash once (important for cross-year continuity)\n",
    "    d = _ensure_content_hash(d, hash_cols=hash_cols, hash_colname=hash_col)\n",
    "\n",
    "    saved = {}\n",
    "\n",
    "    for y in years:\n",
    "        dy = d[d[date_col].dt.year == int(y)].copy()\n",
    "\n",
    "        dy_norepost = _dedupe_within_window(\n",
    "            dy,\n",
    "            date_col=date_col,\n",
    "            hash_col=hash_col,\n",
    "            window_days=window_days,\n",
    "            keep=keep,\n",
    "        )\n",
    "\n",
    "        out_path = os.path.join(\n",
    "            out_dir,\n",
    "            f\"{country_prefix}-{int(y)}-WITHOUT-REPOSTS-W{window_days}D.parquet\"\n",
    "        )\n",
    "\n",
    "        dy_norepost.to_parquet(out_path, index=False, **parquet_kwargs)\n",
    "        saved[int(y)] = out_path\n",
    "\n",
    "        print(f\"[{y}] raw rows: {len(dy)}\")\n",
    "        print(f\"[{y}] after dedupe ({window_days}d, keep={keep}): {len(dy_norepost)}\")\n",
    "        print(f\"Saved → {out_path}\\n\")\n",
    "\n",
    "    return saved"
   ]
  },
