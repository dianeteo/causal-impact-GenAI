    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "def plot_monthly_postings_with_and_without_recruitment_industry(\n",
    "    d_unique: pd.DataFrame,\n",
    "    date_col: str = \"post_date\",\n",
    "    industry_col: str = \"rics_k400\",\n",
    "    recruit_label: str = \"Recruitment and Staffing Services\",\n",
    "    figsize=(10, 4),\n",
    "):\n",
    "    \"\"\"\n",
    "    Plot monthly unique job postings:\n",
    "      - all postings\n",
    "      - postings excluding Recruitment & Staffing Services (rics_k400)\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    d_unique : pd.DataFrame\n",
    "        Repost-cleaned postings dataframe.\n",
    "    date_col : str\n",
    "        Posting date column.\n",
    "    industry_col : str\n",
    "        Industry classification column (e.g. rics_k400).\n",
    "    recruit_label : str\n",
    "        Industry label to exclude.\n",
    "    \"\"\"\n",
    "\n",
    "    # Defensive copy\n",
    "    d = d_unique.copy()\n",
    "\n",
    "    # Ensure datetime\n",
    "    d[date_col] = pd.to_datetime(d[date_col], errors=\"coerce\")\n",
    "    d = d.dropna(subset=[date_col])\n",
    "\n",
    "    # Split data\n",
    "    d_no_recruit = d[d[industry_col] != recruit_label].copy()\n",
    "    d_only_recruit = d[d[industry_col] == recruit_label].copy()\n",
    "\n",
    "    # Reporting\n",
    "    removed_share = len(d_only_recruit) / len(d)\n",
    "    print(f\"Excluded industry: {recruit_label}\")\n",
    "    print(f\"Rows from excluded industry: {len(d_only_recruit)} ({removed_share:.2%} of postings)\")\n",
    "\n",
    "    # Monthly aggregation\n",
    "    def monthly_counts(df):\n",
    "        tmp = df.copy()\n",
    "        tmp[\"month\"] = tmp[date_col].dt.to_period(\"M\").dt.to_timestamp()\n",
    "        return (\n",
    "            tmp.groupby(\"month\")\n",
    "               .size()\n",
    "               .reset_index(name=\"num_postings\")\n",
    "               .sort_values(\"month\")\n",
    "        )\n",
    "\n",
    "    monthly_all = monthly_counts(d)\n",
    "    monthly_no_recruit = monthly_counts(d_no_recruit)\n",
    "    monthly_only_recruit = monthly_counts(d_only_recruit)\n",
    "\n",
    "    # Align months\n",
    "    plot_df = (\n",
    "        monthly_all\n",
    "        .merge(monthly_no_recruit, on=\"month\", how=\"left\", suffixes=(\"_all\", \"_no_recruit\"))\n",
    "        .merge(monthly_only_recruit, on=\"month\", how=\"left\")\n",
    "        .rename(columns={\"num_postings\": \"num_postings_recruitment\"})\n",
    "        .fillna(0)\n",
    "    )\n",
    "\n",
    "    # Plot\n",
    "    plt.figure(figsize=figsize)\n",
    "    plt.plot(\n",
    "        plot_df[\"month\"],\n",
    "        plot_df[\"num_postings_all\"],\n",
    "        linestyle=\"--\",\n",
    "        label=\"All postings\"\n",
    "    )\n",
    "    plt.plot(\n",
    "        plot_df[\"month\"],\n",
    "        plot_df[\"num_postings_no_recruit\"],\n",
    "        marker=\"o\",\n",
    "        label=\"Excluding Recruitment & Staffing\"\n",
    "    )\n",
    "\n",
    "    plt.title(\"Monthly Unique Job Postings: With vs Without Recruitment Industry\")\n",
    "    plt.xlabel(\"Month\")\n",
    "    plt.ylabel(\"Number of postings\")\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    return plot_df"
   ]
  },
