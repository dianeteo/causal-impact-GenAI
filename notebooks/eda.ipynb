    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.ticker import FuncFormatter\n",
    "\n",
    "\n",
    "def plot_linkedin_vs_mom_indexed(\n",
    "    d_unique: pd.DataFrame,\n",
    "    mom_path: str,\n",
    "    date_col: str = \"post_date\",\n",
    "    industry_col: str = \"rics_k400\",\n",
    "    recruit_label: str = \"Recruitment and Staffing Services\",\n",
    "    mom_quarter_col: str = \"quarter\",\n",
    "    mom_vacancy_col: str = \"job_vacancy\",\n",
    "    start_qtr: str = \"2022Q1\",\n",
    "    end_qtr: str = \"2024Q4\",\n",
    "    figsize=(11, 4.5),\n",
    "):\n",
    "    \"\"\"\n",
    "    Single-axis indexed line plot:\n",
    "      - LinkedIn monthly postings (excluding recruitment)\n",
    "      - MOM quarterly vacancies\n",
    "    Both indexed to 100 at start_qtr for trend comparison.\n",
    "    \"\"\"\n",
    "\n",
    "    # -----------------------------\n",
    "    # A) LinkedIn monthly postings\n",
    "    # -----------------------------\n",
    "    d = d_unique.copy()\n",
    "    d[date_col] = pd.to_datetime(d[date_col], errors=\"coerce\")\n",
    "    d = d.dropna(subset=[date_col]).copy()\n",
    "\n",
    "    d = d[d[industry_col] != recruit_label].copy()\n",
    "\n",
    "    d[\"month\"] = d[date_col].dt.to_period(\"M\").dt.to_timestamp()\n",
    "    li_monthly = (\n",
    "        d.groupby(\"month\")\n",
    "         .size()\n",
    "         .reset_index(name=\"postings\")\n",
    "         .sort_values(\"month\")\n",
    "    )\n",
    "\n",
    "    # restrict to window\n",
    "    li_monthly[\"qtr\"] = li_monthly[\"month\"].dt.to_period(\"Q\")\n",
    "    li_monthly = li_monthly[\n",
    "        (li_monthly[\"qtr\"] >= pd.Period(start_qtr, freq=\"Q\")) &\n",
    "        (li_monthly[\"qtr\"] <= pd.Period(end_qtr, freq=\"Q\"))\n",
    "    ].copy()\n",
    "\n",
    "    # index LinkedIn series\n",
    "    li_base = li_monthly.loc[li_monthly[\"qtr\"] == pd.Period(start_qtr, freq=\"Q\"), \"postings\"].mean()\n",
    "    li_monthly[\"index\"] = 100 * li_monthly[\"postings\"] / li_base\n",
    "\n",
    "    # -----------------------------\n",
    "    # B) MOM quarterly vacancies\n",
    "    # -----------------------------\n",
    "    mom = pd.read_csv(mom_path)\n",
    "    mom = mom.rename(columns={c: c.strip().lower() for c in mom.columns})\n",
    "\n",
    "    qcol = mom_quarter_col.lower()\n",
    "    vcol = mom_vacancy_col.lower()\n",
    "\n",
    "    mom[qcol] = mom[qcol].astype(str).str.replace(\"-\", \"\", regex=False)\n",
    "    mom[\"q_period\"] = pd.PeriodIndex(mom[qcol], freq=\"Q\")\n",
    "    mom[vcol] = pd.to_numeric(mom[vcol], errors=\"coerce\")\n",
    "\n",
    "    mom = mom.dropna(subset=[vcol]).copy()\n",
    "    mom = mom[\n",
    "        (mom[\"q_period\"] >= pd.Period(start_qtr, freq=\"Q\")) &\n",
    "        (mom[\"q_period\"] <= pd.Period(end_qtr, freq=\"Q\"))\n",
    "    ].copy()\n",
    "\n",
    "    mom = mom.sort_values(\"q_period\")\n",
    "    mom[\"q_start\"] = mom[\"q_period\"].dt.start_time\n",
    "\n",
    "    # index MOM series\n",
    "    mom_base = mom.loc[mom[\"q_period\"] == pd.Period(start_qtr, freq=\"Q\"), vcol].iloc[0]\n",
    "    mom[\"index\"] = 100 * mom[vcol] / mom_base\n",
    "\n",
    "    # -----------------------------\n",
    "    # C) Plot (single axis)\n",
    "    # -----------------------------\n",
    "    plt.figure(figsize=figsize)\n",
    "\n",
    "    plt.plot(\n",
    "        li_monthly[\"month\"],\n",
    "        li_monthly[\"index\"],\n",
    "        label=\"LinkedIn postings (monthly, excl. recruitment)\",\n",
    "        linewidth=2\n",
    "    )\n",
    "\n",
    "    plt.plot(\n",
    "        mom[\"q_start\"],\n",
    "        mom[\"index\"],\n",
    "        linestyle=\"--\",\n",
    "        marker=\"o\",\n",
    "        label=\"MOM job vacancies (quarterly)\",\n",
    "        linewidth=2\n",
    "    )\n",
    "\n",
    "    plt.axhline(100, linestyle=\":\", linewidth=1)\n",
    "\n",
    "    plt.title(\"Indexed Job Demand: LinkedIn Postings vs MOM Vacancies (2022–2024)\")\n",
    "    plt.xlabel(\"Time\")\n",
    "    plt.ylabel(\"Index (2022Q1 = 100)\")\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    return li_monthly, mom"
   ]
