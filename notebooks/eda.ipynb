    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Treatment date is 2022Q4\n",
    "def build_occ_ind_quarter_panel_highlow_exposure_stata_aligned(\n",
    "    d_unique: pd.DataFrame,\n",
    "    occ_level_path: str,\n",
    "    exposure_col: str = \"human_rating_beta\",\n",
    "    date_col: str = \"post_date\",\n",
    "    onet_postings_col: str = \"onet_code\",\n",
    "    onet_occ_col: str = \"O*NET-SOC Code\",\n",
    "    ind_col: str = \"rics_k50\",\n",
    "    recruit_ind_col: str = \"rics_k400\",\n",
    "    recruit_label: str = \"Recruitment and Staffing Services\",\n",
    "    treat_date: str = \"2022-11-30\",\n",
    "    out_path: str = \"occ_ind_quarter_panel_highlow_human_beta_no_recruit.dta\",\n",
    "    min_qtr: str = \"2022Q1\",\n",
    "    max_qtr: str | None = None,\n",
    "):\n",
    "    d = d_unique.copy()\n",
    "\n",
    "    # 0) Exclude recruitment industry postings\n",
    "    if recruit_ind_col in d.columns:\n",
    "        d = d[d[recruit_ind_col] != recruit_label].copy()\n",
    "\n",
    "    # 1) Dates\n",
    "    d[date_col] = pd.to_datetime(d[date_col], errors=\"coerce\")\n",
    "    d = d.dropna(subset=[date_col]).copy()\n",
    "    treat_dt = pd.Timestamp(treat_date)\n",
    "\n",
    "    # 2) Load exposure table\n",
    "    occ = pd.read_csv(occ_level_path)\n",
    "    if exposure_col not in occ.columns:\n",
    "        raise ValueError(f\"{exposure_col} not found in occ_level.csv. Columns: {list(occ.columns)}\")\n",
    "\n",
    "    # Normalize O*NET codes\n",
    "    d[onet_postings_col] = d[onet_postings_col].astype(str).str.strip()\n",
    "    occ[onet_occ_col] = occ[onet_occ_col].astype(str).str.strip()\n",
    "\n",
    "    occ_sub = occ[[onet_occ_col, exposure_col]].rename(columns={onet_occ_col: onet_postings_col})\n",
    "\n",
    "    # Merge (collision-safe)\n",
    "    d = d.merge(occ_sub, on=onet_postings_col, how=\"left\", indicator=True, suffixes=(\"\", \"_occ\"))\n",
    "    if exposure_col not in d.columns and f\"{exposure_col}_occ\" in d.columns:\n",
    "        d = d.rename(columns={f\"{exposure_col}_occ\": exposure_col})\n",
    "    if exposure_col in d.columns and f\"{exposure_col}_occ\" in d.columns:\n",
    "        d[exposure_col] = d[f\"{exposure_col}_occ\"]\n",
    "        d = d.drop(columns=[f\"{exposure_col}_occ\"])\n",
    "\n",
    "    # Keep matched only\n",
    "    d = d[d[\"_merge\"] == \"both\"].drop(columns=[\"_merge\"]).copy()\n",
    "\n",
    "    # 3) Pre-treatment median at OCCUPATION level (unique occupations pre 30 Nov 2022)\n",
    "    d_pre = d[d[date_col] < treat_dt].copy()\n",
    "    occ_pre = d_pre[[onet_postings_col, exposure_col]].drop_duplicates()\n",
    "    median_pre = float(occ_pre[exposure_col].median())\n",
    "\n",
    "    occ_treat = (\n",
    "        d[[onet_postings_col, exposure_col]]\n",
    "        .drop_duplicates(subset=[onet_postings_col])\n",
    "        .assign(treated=lambda x: (x[exposure_col] > median_pre).astype(\"int64\"))\n",
    "        [[onet_postings_col, \"treated\", exposure_col]]\n",
    "    )\n",
    "\n",
    "    # 4) Quarter + sample range\n",
    "    d[\"qtr\"] = d[date_col].dt.to_period(\"Q\")\n",
    "    qmin = pd.Period(min_qtr, freq=\"Q\")\n",
    "    d = d[d[\"qtr\"] >= qmin].copy()\n",
    "    if max_qtr is not None:\n",
    "        qmax = pd.Period(max_qtr, freq=\"Q\")\n",
    "        d = d[d[\"qtr\"] <= qmax].copy()\n",
    "\n",
    "    if ind_col not in d.columns:\n",
    "        raise ValueError(f\"Industry column '{ind_col}' not in d_unique. Available columns: {list(d.columns)}\")\n",
    "\n",
    "    # 5) Aggregate to occ-ind-quarter\n",
    "    panel = (\n",
    "        d.groupby([onet_postings_col, ind_col, \"qtr\"])\n",
    "         .agg(num_postings=(\"job_id\", \"count\"))\n",
    "         .reset_index()\n",
    "    )\n",
    "\n",
    "    # 6) Balanced grid over observed occ-ind pairs and all quarters\n",
    "    occ_ind_pairs = panel[[onet_postings_col, ind_col]].drop_duplicates()\n",
    "    all_qtrs = pd.period_range(panel[\"qtr\"].min(), panel[\"qtr\"].max(), freq=\"Q\", name=\"qtr\")\n",
    "\n",
    "    occ_ind_pairs[\"_tmp\"] = 1\n",
    "    q_df = pd.DataFrame({\"qtr\": all_qtrs})\n",
    "    q_df[\"_tmp\"] = 1\n",
    "    full = occ_ind_pairs.merge(q_df, on=\"_tmp\", how=\"outer\").drop(columns=[\"_tmp\"])\n",
    "\n",
    "    panel = full.merge(panel, on=[onet_postings_col, ind_col, \"qtr\"], how=\"left\")\n",
    "    panel[\"num_postings\"] = panel[\"num_postings\"].fillna(0).astype(\"int64\")\n",
    "\n",
    "    # 7) Treatment + post (post from 2022Q4 onward)\n",
    "    panel = panel.merge(occ_treat, on=onet_postings_col, how=\"left\")\n",
    "    panel[\"treated\"] = panel[\"treated\"].fillna(0).astype(\"int64\")\n",
    "\n",
    "    TREAT_QTR = pd.Period(\"2022Q4\", freq=\"Q\")\n",
    "    panel[\"post\"] = (panel[\"qtr\"] >= TREAT_QTR).astype(\"int64\")\n",
    "    panel[\"did\"] = (panel[\"treated\"] * panel[\"post\"]).astype(\"int64\")\n",
    "    panel[\"log_postings\"] = np.log(panel[\"num_postings\"] + 1)\n",
    "\n",
    "    # 8) Stata-aligned time vars: year, qtr_num, tq, t_index, relq\n",
    "    panel[\"year\"] = panel[\"qtr\"].dt.year.astype(\"int64\")\n",
    "    panel[\"qtr_num\"] = panel[\"qtr\"].dt.quarter.astype(\"int64\")\n",
    "\n",
    "    panel[\"tq\"] = ((panel[\"year\"] - 1960) * 4 + (panel[\"qtr_num\"] - 1)).astype(\"int32\")\n",
    "\n",
    "    base_tq = (2022 - 1960) * 4 + (1 - 1)  # yq(2022,1)\n",
    "    event_tq = (2022 - 1960) * 4 + (4 - 1) # yq(2022,4)\n",
    "\n",
    "    panel[\"t_index\"] = (panel[\"tq\"] - base_tq).astype(\"int64\")\n",
    "    panel[\"relq\"] = (panel[\"tq\"] - event_tq).astype(\"int64\")\n",
    "\n",
    "    # 9) IDs for FE regressions\n",
    "    panel[\"occ_id\"] = panel[onet_postings_col].astype(\"category\").cat.codes.astype(\"int64\") + 1\n",
    "    panel[\"ind_id\"] = panel[ind_col].astype(\"category\").cat.codes.astype(\"int64\") + 1\n",
    "    panel[\"occ_ind_id\"] = panel[[onet_postings_col, ind_col]].astype(str).agg(\"|\".join, axis=1).astype(\"category\").cat.codes.astype(\"int64\") + 1\n",
    "\n",
    "    # Optional: helpful readable quarter string\n",
    "    panel[\"qtr_str\"] = panel[\"qtr\"].astype(str)\n",
    "\n",
    "    # Drop Period column for Stata export\n",
    "    panel = panel.drop(columns=[\"qtr\"])\n",
    "\n",
    "    # Sort\n",
    "    panel = panel.sort_values([\"occ_ind_id\", \"year\", \"qtr_num\"]).reset_index(drop=True)\n",
    "\n",
    "    # Save\n",
    "    panel.to_stata(out_path, write_index=False, version=118)\n",
    "\n",
    "    print(\"Saved:\", out_path)\n",
    "    print(\"Rows:\", len(panel))\n",
    "    print(\"Unique occ-ind:\", panel[\"occ_ind_id\"].nunique())\n",
    "    print(\"Quarters:\", panel[[\"year\", \"qtr_num\"]].drop_duplicates().shape[0])\n",
    "    print(f\"Pre-treatment occupation median ({exposure_col}): {median_pre:.4f}\")\n",
    "\n",
    "    return panel, median_pre"
   ]
  },
