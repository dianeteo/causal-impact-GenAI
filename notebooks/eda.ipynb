   "source": [
    "firm_q = (\n",
    "    d_unique\n",
    "    .groupby(\n",
    "        [\"quarter\", \"ultimate_parent_rcid\", \"ultimate_parent_company_name\"],\n",
    "        dropna=False\n",
    "    )\n",
    "    .size()\n",
    "    .reset_index(name=\"postings\")\n",
    ")\n",
    "\n",
    "firm_pivot = (\n",
    "    firm_q\n",
    "    .pivot(\n",
    "        index=[\"ultimate_parent_rcid\", \"ultimate_parent_company_name\"],\n",
    "        columns=\"quarter\",\n",
    "        values=\"postings\"\n",
    "    )\n",
    "    .fillna(0)\n",
    ")\n",
    "\n",
    "firm_pivot[\"delta_Q3_Q2_2022\"] = (\n",
    "    firm_pivot.get(q_spike, 0) - firm_pivot.get(q_pre, 0)\n",
    ")\n",
    "\n",
    "top_firms_spike = (\n",
    "    firm_pivot\n",
    "    .sort_values(\"delta_Q3_Q2_2022\", ascending=False)\n",
    "    .reset_index()\n",
    "    .head(20)\n",
    ")\n",
    "\n",
    "top_firms_spike"
   ]
  },
