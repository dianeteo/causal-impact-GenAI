    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "def plot_top_shares_2023_01(\n",
    "    d_unique: pd.DataFrame,\n",
    "    exclude_firms,\n",
    "    target_month: str = \"2023-01\",\n",
    "    date_col: str = \"post_date\",\n",
    "    firm_col: str = \"ultimate_parent_company_name\",\n",
    "    ind_col: str = \"rics_k50\",\n",
    "    top_n_industries: int = 15,\n",
    "    top_n_firms: int = 20,\n",
    "    figsize=(10, 5),\n",
    "):\n",
    "    \"\"\"\n",
    "    For a given month (default: 2023-01), plot:\n",
    "      1) Industry share of postings (top N) - Before vs After excluding firms\n",
    "      2) Firm share of postings (top N) - Before vs After excluding firms\n",
    "\n",
    "    Outputs 4 sorted horizontal bar charts.\n",
    "    \"\"\"\n",
    "\n",
    "    # --- prep ---\n",
    "    d = d_unique.copy()\n",
    "    d[date_col] = pd.to_datetime(d[date_col], errors=\"coerce\")\n",
    "    d = d.dropna(subset=[date_col])\n",
    "\n",
    "    if isinstance(exclude_firms, str):\n",
    "        exclude_firms = [exclude_firms]\n",
    "    exclude_firms = set(exclude_firms)\n",
    "\n",
    "    # month filter\n",
    "    month_ts = pd.Period(target_month, freq=\"M\").to_timestamp()\n",
    "    d[\"month\"] = d[date_col].dt.to_period(\"M\").dt.to_timestamp()\n",
    "    dm = d[d[\"month\"] == month_ts].copy()\n",
    "\n",
    "    if dm.empty:\n",
    "        print(f\"[WARN] No rows found for month {target_month}.\")\n",
    "        return\n",
    "\n",
    "    # split before / after exclusion\n",
    "    dm_all = dm.copy()\n",
    "    dm_excl = dm[~dm[firm_col].isin(exclude_firms)].copy()\n",
    "\n",
    "    # helper: shares\n",
    "    def share_table(df, key_col):\n",
    "        tab = (\n",
    "            df.groupby(key_col, dropna=False)\n",
    "              .size()\n",
    "              .reset_index(name=\"postings\")\n",
    "              .sort_values(\"postings\", ascending=False)\n",
    "        )\n",
    "        total = tab[\"postings\"].sum()\n",
    "        tab[\"share\"] = tab[\"postings\"] / total\n",
    "        return tab, total\n",
    "\n",
    "    # ----- Industry shares -----\n",
    "    ind_all, tot_all = share_table(dm_all, ind_col)\n",
    "    ind_excl, tot_excl = share_table(dm_excl, ind_col)\n",
    "\n",
    "    # take top N based on ALL (so charts are comparable)\n",
    "    top_inds = ind_all.head(top_n_industries)[ind_col].tolist()\n",
    "    ind_all_plot = ind_all[ind_all[ind_col].isin(top_inds)].copy()\n",
    "    ind_excl_plot = ind_excl[ind_excl[ind_col].isin(top_inds)].copy()\n",
    "\n",
    "    # align and fill missing\n",
    "    ind_plot = (\n",
    "        pd.DataFrame({ind_col: top_inds})\n",
    "        .merge(ind_all_plot[[ind_col, \"share\"]].rename(columns={\"share\": \"share_all\"}), on=ind_col, how=\"left\")\n",
    "        .merge(ind_excl_plot[[ind_col, \"share\"]].rename(columns={\"share\": \"share_excluding\"}), on=ind_col, how=\"left\")\n",
    "        .fillna(0)\n",
    "    )\n",
    "\n",
    "    # sort by share_all ascending for nicer horizontal bars\n",
    "    ind_plot = ind_plot.sort_values(\"share_all\", ascending=True)\n",
    "\n",
    "    # ----- Firm shares -----\n",
    "    firm_all, totf_all = share_table(dm_all, firm_col)\n",
    "    firm_excl, totf_excl = share_table(dm_excl, firm_col)\n",
    "\n",
    "    top_firms = firm_all.head(top_n_firms)[firm_col].tolist()\n",
    "    firm_all_plot = firm_all[firm_all[firm_col].isin(top_firms)].copy()\n",
    "    firm_excl_plot = firm_excl[firm_excl[firm_col].isin(top_firms)].copy()\n",
    "\n",
    "    firm_plot = (\n",
    "        pd.DataFrame({firm_col: top_firms})\n",
    "        .merge(firm_all_plot[[firm_col, \"share\"]].rename(columns={\"share\": \"share_all\"}), on=firm_col, how=\"left\")\n",
    "        .merge(firm_excl_plot[[firm_col, \"share\"]].rename(columns={\"share\": \"share_excluding\"}), on=firm_col, how=\"left\")\n",
    "        .fillna(0)\n",
    "    )\n",
    "    firm_plot = firm_plot.sort_values(\"share_all\", ascending=True)\n",
    "\n",
    "    # --- plotting helpers ---\n",
    "    def barh_compare(df_plot, label_col, title, xlabel=\"Share of postings\"):\n",
    "        plt.figure(figsize=figsize)\n",
    "        y = df_plot[label_col].astype(str)\n",
    "\n",
    "        plt.barh(y, df_plot[\"share_all\"], label=\"All firms\", alpha=0.85)\n",
    "        plt.barh(y, df_plot[\"share_excluding\"], label=\"Excluding selected firms\", alpha=0.85)\n",
    "\n",
    "        plt.title(title)\n",
    "        plt.xlabel(xlabel)\n",
    "        plt.legend()\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    print(f\"[INFO] Month = {target_month}\")\n",
    "    print(f\"[INFO] Total postings (all firms): {tot_all:,}\")\n",
    "    print(f\"[INFO] Total postings (excluding firms): {tot_excl:,}\")\n",
    "    print(f\"[INFO] Excluded firms: {exclude_firms}\")\n",
    "\n",
    "    # 1) Industry shares\n",
    "    barh_compare(\n",
    "        ind_plot,\n",
    "        ind_col,\n",
    "        title=f\"Industry share of postings in {target_month} (Top {top_n_industries})\\nAll vs Excluding selected firms\"\n",
    "    )\n",
    "\n",
    "    # 2) Firm shares\n",
    "    barh_compare(\n",
    "        firm_plot,\n",
    "        firm_col,\n",
    "        title=f\"Firm share of postings in {target_month} (Top {top_n_firms})\\nAll vs Excluding selected firms\"\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"industry_share_table\": ind_plot,\n",
    "        \"firm_share_table\": firm_plot,\n",
    "        \"totals\": {\n",
    "            \"month\": target_month,\n",
    "            \"total_all\": tot_all,\n",
    "            \"total_excluding\": tot_excl\n",
    "        }\n",
    "    }\n",
    "\n",
    "\n",
    "# Example usage:\n",
    "exclude_firms = [\"Supreme HR Advisory Pte Ltd.\", \"Career Edge Asia Pte Ltd.\"]\n",
    "\n",
    "results = plot_top_shares_2023_01(\n",
    "    d_unique=d_unique,\n",
    "    exclude_firms=exclude_firms,\n",
    "    target_month=\"2023-01\",\n",
    "    top_n_industries=15,\n",
    "    top_n_firms=20\n",
    ")"
   ]
  },
