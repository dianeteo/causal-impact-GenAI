    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "def build_occ_ind_q_panel_and_save_dta(\n",
    "    postings_df: pd.DataFrame,\n",
    "    exposure_df: pd.DataFrame,\n",
    "    exclude_firms=None,\n",
    "    out_path: str = \"occ_ind_quarter_panel_W60D.dta\",\n",
    "    date_col: str = \"post_date\",\n",
    "    onet_col: str = \"onet_code\",\n",
    "    ind_col: str = \"rics_k50\",\n",
    "    firm_col: str = \"ultimate_parent_company_name\",\n",
    "    count_col: str = \"job_id\",\n",
    "    treatment_q: str = \"2023Q1\",\n",
    "    first_q: str = \"2022Q1\",\n",
    "):\n",
    "    \"\"\"\n",
    "    Build occupation × industry × quarter panel with firm exclusions enforced FIRST.\n",
    "    Keeps ONLY occ×ind pairs observed before treatment_q.\n",
    "    Saves to Stata .dta.\n",
    "\n",
    "    Adds to panel:\n",
    "      - occ_human_beta, occ_dv_beta (occ-stem level)\n",
    "      - pre_median_human_beta, pre_median_dv_beta (computed on pre-treatment occ set)\n",
    "      - treated_human, treated_dv (above respective pre-period medians)\n",
    "      - post (>= treatment_q)\n",
    "    \"\"\"\n",
    "\n",
    "    def onet_stem(x):\n",
    "        if pd.isna(x):\n",
    "            return pd.NA\n",
    "        return str(x).strip().split(\".\")[0]\n",
    "\n",
    "    # -----------------------------\n",
    "    # 0) Clean postings + EXCLUDE FIRMS\n",
    "    # -----------------------------\n",
    "    df = postings_df.copy()\n",
    "    df[date_col] = pd.to_datetime(df[date_col], errors=\"coerce\")\n",
    "    df = df.dropna(subset=[date_col])\n",
    "\n",
    "    if firm_col in df.columns:\n",
    "        df[firm_col] = df[firm_col].astype(\"string\").str.strip()\n",
    "\n",
    "    if exclude_firms is not None:\n",
    "        if isinstance(exclude_firms, str):\n",
    "            exclude_firms = [exclude_firms]\n",
    "        exclude_firms = set([str(x).strip() for x in exclude_firms])\n",
    "        before = len(df)\n",
    "        df = df[~df[firm_col].isin(exclude_firms)].copy()\n",
    "        after = len(df)\n",
    "        print(f\"[INFO] Excluded firms: {exclude_firms}\")\n",
    "        print(f\"[INFO] Rows removed: {before - after} ({(before - after)/before:.2%})\")\n",
    "\n",
    "    # -----------------------------\n",
    "    # 1) Time & identifiers\n",
    "    # -----------------------------\n",
    "    first_q_p = pd.Period(first_q, freq=\"Q\")\n",
    "    treat_q_p = pd.Period(treatment_q, freq=\"Q\")\n",
    "\n",
    "    df[\"year_quarter\"] = df[date_col].dt.to_period(\"Q\").astype(str)\n",
    "    df = df[pd.PeriodIndex(df[\"year_quarter\"], freq=\"Q\") >= first_q_p].copy()\n",
    "\n",
    "    # Occupation & industry\n",
    "    df[onet_col] = df[onet_col].astype(\"string\").str.strip()\n",
    "    empty_tokens = [\"\", \"nan\", \"none\", \"null\", \".\", \"na\", \"N/A\", \"NaN\", \"None\", \"NULL\"]\n",
    "    df[onet_col] = df[onet_col].replace(empty_tokens, pd.NA)\n",
    "    df = df.dropna(subset=[onet_col])\n",
    "\n",
    "    df[\"occ\"] = df[onet_col].map(onet_stem).astype(\"string\")\n",
    "    df = df.dropna(subset=[\"occ\"])\n",
    "\n",
    "    df[\"ind\"] = df[ind_col].astype(\"string\").str.strip()\n",
    "    df = df.dropna(subset=[\"ind\"])\n",
    "\n",
    "    # -----------------------------\n",
    "    # 2) Exposure (occ-level): keep both human_beta and dv_beta\n",
    "    # -----------------------------\n",
    "    exp = exposure_df.copy()\n",
    "    needed = [\"O*NET-SOC Code\", \"human_rating_beta\", \"dv_rating_beta\"]\n",
    "    missing = [c for c in needed if c not in exp.columns]\n",
    "    if missing:\n",
    "        raise ValueError(f\"exposure_df missing required columns: {missing}\")\n",
    "\n",
    "    exp[\"occ\"] = exp[\"O*NET-SOC Code\"].astype(\"string\").map(onet_stem)\n",
    "\n",
    "    occ_scores = (\n",
    "        exp.dropna(subset=[\"occ\"])\n",
    "           .groupby(\"occ\", as_index=False)\n",
    "           .agg(\n",
    "               occ_human_beta=(\"human_rating_beta\", \"mean\"),\n",
    "               occ_dv_beta=(\"dv_rating_beta\", \"mean\"),\n",
    "           )\n",
    "    )\n",
    "\n",
    "    # -----------------------------\n",
    "    # 3) KEEP ONLY PRE-TREATMENT occ×ind PAIRS\n",
    "    # -----------------------------\n",
    "    q_index = pd.PeriodIndex(df[\"year_quarter\"], freq=\"Q\")\n",
    "    pre_pairs = (\n",
    "        df[q_index < treat_q_p][[\"occ\", \"ind\"]]\n",
    "        .drop_duplicates()\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "    df = df.merge(pre_pairs.assign(_keep=1), on=[\"occ\", \"ind\"], how=\"inner\").drop(columns=\"_keep\")\n",
    "    q_index = pd.PeriodIndex(df[\"year_quarter\"], freq=\"Q\")\n",
    "\n",
    "    # -----------------------------\n",
    "    # 4) Build panel grid\n",
    "    # -----------------------------\n",
    "    max_q = pd.Period(df[\"year_quarter\"].max(), freq=\"Q\")\n",
    "    all_quarters = pd.period_range(first_q_p, max_q, freq=\"Q\").astype(str)\n",
    "    q_df = pd.DataFrame({\"year_quarter\": all_quarters})\n",
    "    pre_pairs[\"_k\"] = 1\n",
    "    q_df[\"_k\"] = 1\n",
    "    panel = pre_pairs.merge(q_df, on=\"_k\").drop(columns=\"_k\")\n",
    "\n",
    "    # -----------------------------\n",
    "    # 5) Aggregate postings\n",
    "    # -----------------------------\n",
    "    if count_col in df.columns:\n",
    "        cell_counts = df.groupby([\"occ\", \"ind\", \"year_quarter\"], as_index=False).agg(num_postings=(count_col, \"count\"))\n",
    "    else:\n",
    "        cell_counts = df.groupby([\"occ\", \"ind\", \"year_quarter\"], as_index=False).size().rename(columns={\"size\": \"num_postings\"})\n",
    "\n",
    "    panel = panel.merge(cell_counts, on=[\"occ\", \"ind\", \"year_quarter\"], how=\"left\")\n",
    "    panel[\"num_postings\"] = panel[\"num_postings\"].fillna(0).astype(\"int64\")\n",
    "    panel[\"log_postings\"] = np.log(panel[\"num_postings\"] + 1)\n",
    "\n",
    "    # -----------------------------\n",
    "    # 6) Merge scores + compute pre-medians for BOTH methods\n",
    "    # -----------------------------\n",
    "    panel = panel.merge(occ_scores, on=\"occ\", how=\"left\")\n",
    "    panel[\"occ_human_beta\"] = panel[\"occ_human_beta\"].fillna(0.0).astype(float)\n",
    "    panel[\"occ_dv_beta\"] = panel[\"occ_dv_beta\"].fillna(0.0).astype(float)\n",
    "\n",
    "    pre_occs = df[q_index < treat_q_p][\"occ\"].unique()\n",
    "\n",
    "    pre_pool_h = occ_scores.loc[occ_scores[\"occ\"].isin(pre_occs), \"occ_human_beta\"]\n",
    "    pre_pool_d = occ_scores.loc[occ_scores[\"occ\"].isin(pre_occs), \"occ_dv_beta\"]\n",
    "\n",
    "    pre_median_h = float(pre_pool_h.median()) if len(pre_pool_h) else float(occ_scores[\"occ_human_beta\"].median())\n",
    "    pre_median_d = float(pre_pool_d.median()) if len(pre_pool_d) else float(occ_scores[\"occ_dv_beta\"].median())\n",
    "\n",
    "    panel[\"pre_median_human_beta\"] = pre_median_h\n",
    "    panel[\"pre_median_dv_beta\"] = pre_median_d\n",
    "\n",
    "    panel[\"treated_human\"] = (panel[\"occ_human_beta\"] > pre_median_h).astype(\"int8\")\n",
    "    panel[\"treated_dv\"] = (panel[\"occ_dv_beta\"] > pre_median_d).astype(\"int8\")\n",
    "\n",
    "    panel[\"post\"] = (pd.PeriodIndex(panel[\"year_quarter\"], freq=\"Q\") >= treat_q_p).astype(\"int8\")\n",
    "\n",
    "    panel = panel.sort_values([\"occ\", \"ind\", \"year_quarter\"]).reset_index(drop=True)\n",
    "    panel[\"occ_ind_id\"] = pd.factorize(list(zip(panel[\"occ\"].astype(str), panel[\"ind\"].astype(str))))[0] + 1\n",
    "\n",
    "    # -----------------------------\n",
    "    # 7) Save to Stata\n",
    "    # -----------------------------\n",
    "    for c in [\"occ\", \"ind\", \"year_quarter\"]:\n",
    "        panel[c] = panel[c].astype(str)\n",
    "\n",
    "    panel.to_stata(out_path, write_index=False, version=118)\n",
    "\n",
    "    print(f\"[OK] Saved panel → {out_path}\")\n",
    "    print(f\"[INFO] Panel shape: {panel.shape}\")\n",
    "    print(f\"[INFO] Unique pre-treatment occ×ind pairs: {panel[['occ','ind']].drop_duplicates().shape[0]:,}\")\n",
    "    print(f\"[INFO] Pre-treatment median human_beta: {pre_median_h:.4f}\")\n",
    "    print(f\"[INFO] Pre-treatment median dv_beta: {pre_median_d:.4f}\")\n",
    "\n",
    "    return panel"
   ]
  },
