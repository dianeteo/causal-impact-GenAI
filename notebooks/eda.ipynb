    "\n",
    "    # 4) Quarter + sample range\n",
    "    d[\"qtr\"] = d[date_col].dt.to_period(\"Q\")\n",
    "    qmin = pd.Period(min_qtr, freq=\"Q\")\n",
    "    d = d[d[\"qtr\"] >= qmin].copy()\n",
    "    if max_qtr is not None:\n",
    "        qmax = pd.Period(max_qtr, freq=\"Q\")\n",
    "        d = d[d[\"qtr\"] <= qmax].copy()\n",
    "\n",
    "    if ind_col not in d.columns:\n",
    "        raise ValueError(f\"Industry column '{ind_col}' not in d_unique. Available columns: {list(d.columns)}\")\n",
    "\n",
    "    # 5) Aggregate to occ-ind-quarter\n",
    "    panel = (\n",
    "        d.groupby([onet_postings_col, ind_col, \"qtr\"])\n",
    "         .agg(num_postings=(\"job_id\", \"count\"))\n",
    "         .reset_index()\n",
    "    )\n",
    "\n",
    "    # 6) Balanced grid over observed occ-ind pairs (ALL-EVER) and all quarters\n",
    "    occ_ind_pairs = panel[[onet_postings_col, ind_col]].drop_duplicates()\n",
    "    all_qtrs = pd.period_range(panel[\"qtr\"].min(), panel[\"qtr\"].max(), freq=\"Q\", name=\"qtr\")\n",
    "\n",
    "    occ_ind_pairs[\"_tmp\"] = 1\n",
    "    q_df = pd.DataFrame({\"qtr\": all_qtrs})\n",
    "    q_df[\"_tmp\"] = 1\n",
    "    full = occ_ind_pairs.merge(q_df, on=\"_tmp\", how=\"outer\").drop(columns=[\"_tmp\"])\n",
    "\n",
    "    panel = full.merge(panel, on=[onet_postings_col, ind_col, \"qtr\"], how=\"left\")\n",
    "    panel[\"num_postings\"] = panel[\"num_postings\"].fillna(0).astype(\"int64\")\n",
    "\n",
    "    # 7) Treatment + post (post from event quarter onward)\n",
    "    panel = panel.merge(occ_treat, on=onet_postings_col, how=\"left\")\n",
    "    panel[\"treated\"] = panel[\"treated\"].fillna(0).astype(\"int64\")\n",
    "\n",
    "    EVENT_QTR = pd.Period(event_qtr, freq=\"Q\")\n",
    "    panel[\"post\"] = (panel[\"qtr\"] >= EVENT_QTR).astype(\"int64\")\n",
    "    panel[\"did\"] = (panel[\"treated\"] * panel[\"post\"]).astype(\"int64\")\n",
    "    panel[\"log_postings\"] = np.log(panel[\"num_postings\"] + 1)\n",
    "\n",
    "    # 8) Stata-friendly time vars: year, qtr_num, tq, t_index, relq\n",
    "    panel[\"year\"] = panel[\"qtr\"].dt.year.astype(\"int64\")\n",
    "    panel[\"qtr_num\"] = panel[\"qtr\"].dt.quarter.astype(\"int64\")\n",
    "    panel[\"tq\"] = ((panel[\"year\"] - 1960) * 4 + (panel[\"qtr_num\"] - 1)).astype(\"int32\")\n",
    "\n",
    "    base_tq = (2022 - 1960) * 4 + (1 - 1)  # yq(2022,1)\n",
    "    event_tq = (EVENT_QTR.year - 1960) * 4 + (EVENT_QTR.quarter - 1)  # yq(event_year,event_qtr)\n",
    "\n",
    "    panel[\"t_index\"] = (panel[\"tq\"] - base_tq).astype(\"int64\")\n",
    "    panel[\"relq\"] = (panel[\"tq\"] - event_tq).astype(\"int64\")\n",
    "\n",
    "    # 9) IDs for FE regressions\n",
    "    panel[\"occ_id\"] = panel[onet_postings_col].astype(\"category\").cat.codes.astype(\"int64\") + 1\n",
    "    panel[\"ind_id\"] = panel[ind_col].astype(\"category\").cat.codes.astype(\"int64\") + 1\n",
    "    panel[\"occ_ind_id\"] = panel[[onet_postings_col, ind_col]].astype(str).agg(\"|\".join, axis=1).astype(\"category\").cat.codes.astype(\"int64\") + 1\n",
    "    panel[\"qtr_str\"] = panel[\"qtr\"].astype(str)\n",
    "\n",
    "    # Drop Period for Stata\n",
    "    panel = panel.drop(columns=[\"qtr\"])\n",
    "    panel = panel.sort_values([\"occ_ind_id\", \"year\", \"qtr_num\"]).reset_index(drop=True)\n",
    "\n",
    "    # Save to ../data/{filename}.dta\n",
    "    out_path = os.path.join(\"..\", \"data\", out_filename)\n",
    "    panel.to_stata(out_path, write_index=False, version=118)\n",
    "\n",
    "    print(\"Saved:\", out_path)\n",
    "    print(\"Rows:\", len(panel))\n",
    "    print(\"Unique occ-ind:\", panel[\"occ_ind_id\"].nunique())\n",
    "    print(\"Quarters:\", panel[[\"year\", \"qtr_num\"]].drop_duplicates().shape[0])\n",
    "    print(f\"Pre-treatment occupation median ({exposure_col}): {median_pre:.4f}\")\n",
    "    print(f\"Event quarter: {EVENT_QTR}\")\n",
    "\n",
    "    return panel, median_pre"
   ]
  },
