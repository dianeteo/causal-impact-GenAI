   "source": [
    "occ_q = (\n",
    "    d_unique\n",
    "    .groupby([\"quarter\", \"onet_code\"])\n",
    "    .size()\n",
    "    .reset_index(name=\"postings\")\n",
    ")\n",
    "\n",
    "pivot_occ = (\n",
    "    occ_q\n",
    "    .pivot(index=\"onet_code\", columns=\"quarter\", values=\"postings\")\n",
    "    .fillna(0)\n",
    ")\n",
    "\n",
    "pivot_occ[\"delta_Q3_Q2_2022\"] = (\n",
    "    pivot_occ.get(\"2022Q3\", 0) - pivot_occ.get(\"2022Q2\", 0)\n",
    ")\n",
    "\n",
    "top_occ = (\n",
    "    pivot_occ\n",
    "    .sort_values(\"delta_Q3_Q2_2022\", ascending=False)\n",
    "    .head(20)\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "top_occ\n",
    "\n",
    "\n",
    "top_occ_named = top_occ.merge(\n",
    "    exposure_df[[\"O*NET-SOC Code\", \"Title\"]],\n",
    "    left_on=\"onet_code\",\n",
    "    right_on=\"O*NET-SOC Code\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "top_occ_named"
   ]
  },
