   "source": [
    "d = _ensure_content_hash(data_df)\n",
    "d[\"post_date\"] = pd.to_datetime(d[\"post_date\"], errors=\"coerce\")\n",
    "d = d.dropna(subset=[\"post_date\"]).sort_values([\"content_hash\", \"post_date\"])\n",
    "\n",
    "gaps = d.groupby(\"content_hash\")[\"post_date\"].diff().dt.days.dropna()\n",
    "\n",
    "gaps.describe(percentiles=[0.5, 0.75, 0.9, 0.95, 0.99])"
   ]
