   "source": [
    "HR Services seems to be the industry that is driving the huge spike in job postings, so we investigate the job titles within the HR services category that are driving this demand."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 156,
   "id": "0d5cb170",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "HR postings share: 0.31210368398134875\n"
     ]
    }
   ],
   "source": [
    "# --- Filter to HR industry only ---\n",
    "HR_LABEL = \"Human Resources Services\"\n",
    "\n",
    "d_hr = d_unique[d_unique[\"rics_k50\"] == HR_LABEL].copy()\n",
    "\n",
    "# Sanity check\n",
    "print(\"HR postings share:\", len(d_hr) / len(d_unique))\n",
    "\n",
    "d_hr[\"quarter\"] = d_hr[\"post_date\"].dt.to_period(\"Q\")\n"
   ]
  },
