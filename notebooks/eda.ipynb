   "source": [
    "hr_occ_q = (\n",
    "    d_hr\n",
    "    .groupby([\"quarter\", \"onet_code\"])\n",
    "    .size()\n",
    "    .reset_index(name=\"postings\")\n",
    ")\n",
    "\n",
    "hr_pivot = (\n",
    "    hr_occ_q\n",
    "    .pivot(index=\"onet_code\", columns=\"quarter\", values=\"postings\")\n",
    "    .fillna(0)\n",
    ")\n",
    "\n",
    "q_2022Q2 = pd.Period(\"2022Q2\", freq=\"Q\")\n",
    "q_2022Q3 = pd.Period(\"2022Q3\", freq=\"Q\")\n",
    "\n",
    "hr_pivot[\"delta_2022Q3_Q2\"] = (\n",
    "    hr_pivot.get(q_2022Q3, 0) - hr_pivot.get(q_2022Q2, 0)\n",
    ")\n",
    "\n",
    "\n",
    "top_hr_Q3 = (\n",
    "    hr_pivot\n",
    "    .sort_values(\"delta_2022Q3_Q2\", ascending=False)\n",
    "    .head(20)\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# top_hr_Q3\n",
    "\n",
    "top_hr_Q3_named = top_hr_Q3.merge(\n",
    "    exposure_df[[\"O*NET-SOC Code\", \"Title\"]],\n",
    "    left_on=\"onet_code\",\n",
    "    right_on=\"O*NET-SOC Code\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "top_hr_Q3_named\n"
   ]
  },
