    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def plot_quarterly_high_low_occ_exposure_no_recruit(\n",
    "    d_unique: pd.DataFrame,\n",
    "    occ_level_path: str,\n",
    "    exposure_col: str = \"human_rating_beta\",\n",
    "    date_col: str = \"post_date\",\n",
    "    onet_postings_col: str = \"onet_code\",\n",
    "    onet_occ_col: str = \"O*NET-SOC Code\",\n",
    "    industry_col: str = \"rics_k400\",\n",
    "    recruit_label: str = \"Recruitment and Staffing Services\",\n",
    "    treat_date: str = \"2022-11-30\",\n",
    "    figsize=(10, 4),\n",
    "):\n",
    "    \"\"\"\n",
    "    Same logic as the monthly function, but aggregates postings by QUARTER.\n",
    "    Treatment date is a specific date (default 2022-11-30). Vertical line is placed at that date.\n",
    "    High vs Low defined by PRE-treatment occupation-level median of exposure_col (unique occupations, not weighted).\n",
    "    Excludes Recruitment and Staffing Services by rics_k400.\n",
    "    \"\"\"\n",
    "\n",
    "    d = d_unique.copy()\n",
    "\n",
    "    # 0) Filter out recruitment industry\n",
    "    if industry_col in d.columns:\n",
    "        d = d[d[industry_col] != recruit_label].copy()\n",
    "\n",
    "    # 1) Dates\n",
    "    d[date_col] = pd.to_datetime(d[date_col], errors=\"coerce\")\n",
    "    d = d.dropna(subset=[date_col]).copy()\n",
    "    treat_dt = pd.Timestamp(treat_date)\n",
    "\n",
    "    # 2) Load occupation exposure and merge\n",
    "    occ = pd.read_csv(occ_level_path)\n",
    "    if exposure_col not in occ.columns:\n",
    "        raise ValueError(f\"{exposure_col} not found in occ_level.csv. Available columns: {list(occ.columns)}\")\n",
    "\n",
    "    d[onet_postings_col] = d[onet_postings_col].astype(str).str.strip()\n",
    "    occ[onet_occ_col] = occ[onet_occ_col].astype(str).str.strip()\n",
    "\n",
    "    occ_sub = occ[[onet_occ_col, exposure_col]].rename(columns={onet_occ_col: onet_postings_col})\n",
    "\n",
    "    d = d.merge(\n",
    "        occ_sub,\n",
    "        on=onet_postings_col,\n",
    "        how=\"left\",\n",
    "        indicator=True,\n",
    "        suffixes=(\"\", \"_occ\")\n",
    "    )\n",
    "\n",
    "    # Handle collisions robustly\n",
    "    if exposure_col not in d.columns and f\"{exposure_col}_occ\" in d.columns:\n",
    "        d = d.rename(columns={f\"{exposure_col}_occ\": exposure_col})\n",
    "    if exposure_col in d.columns and f\"{exposure_col}_occ\" in d.columns:\n",
    "        d[exposure_col] = d[f\"{exposure_col}_occ\"]\n",
    "        d = d.drop(columns=[f\"{exposure_col}_occ\"])\n",
    "\n",
    "    if exposure_col not in d.columns:\n",
    "        raise KeyError(\n",
    "            f\"After merge, '{exposure_col}' not found. Columns containing '{exposure_col}': \"\n",
    "            f\"{[c for c in d.columns if exposure_col in c]}\"\n",
    "        )\n",
    "\n",
    "    # Merge diagnostics\n",
    "    merge_counts = d[\"_merge\"].value_counts(dropna=False).to_dict()\n",
    "    n_left_only = merge_counts.get(\"left_only\", 0)\n",
    "    n_both = merge_counts.get(\"both\", 0)\n",
    "    print(f\"Merge diagnostics: matched={n_both:,}, unmatched={n_left_only:,}, match_rate={n_both/(n_both+n_left_only):.2%}\")\n",
    "\n",
    "    # Keep matched only\n",
    "    d = d[d[\"_merge\"] == \"both\"].copy()\n",
    "    d = d.drop(columns=[\"_merge\"])\n",
    "\n",
    "    # 3) Pre-treatment median at OCCUPATION level\n",
    "    d_pre = d[d[date_col] < treat_dt].copy()\n",
    "    occ_pre = d_pre[[onet_postings_col, exposure_col]].drop_duplicates()\n",
    "    median_pre = float(occ_pre[exposure_col].median())\n",
    "\n",
    "    # 4) Classify high/low and aggregate by quarter\n",
    "    d[\"high_exposure_occ\"] = (d[exposure_col] > median_pre).astype(int)\n",
    "    d[\"quarter\"] = d[date_col].dt.to_period(\"Q\")\n",
    "    d[\"quarter_start\"] = d[\"quarter\"].dt.start_time  # for plotting on a date axis\n",
    "\n",
    "    quarterly = (\n",
    "        d.groupby([\"quarter_start\", \"high_exposure_occ\"])\n",
    "         .size()\n",
    "         .reset_index(name=\"num_postings\")\n",
    "    )\n",
    "\n",
    "    plot_df = (\n",
    "        quarterly.pivot(index=\"quarter_start\", columns=\"high_exposure_occ\", values=\"num_postings\")\n",
    "                 .rename(columns={0: \"num_postings_low\", 1: \"num_postings_high\"})\n",
    "                 .fillna(0)\n",
    "                 .reset_index()\n",
    "                 .sort_values(\"quarter_start\")\n",
    "    )\n",
    "\n",
    "    # 5) Plot\n",
    "    plt.figure(figsize=figsize)\n",
    "    plt.plot(plot_df[\"quarter_start\"], plot_df[\"num_postings_low\"], marker=\"o\", label=\"Low exposure occupations\")\n",
    "    plt.plot(plot_df[\"quarter_start\"], plot_df[\"num_postings_high\"], marker=\"o\", label=\"High exposure occupations\")\n",
    "    plt.axvline(treat_dt, linestyle=\"--\", alpha=0.7)\n",
    "\n",
    "    plt.title(f\"Quarterly postings (excluding recruitment): High vs Low occ exposure ({exposure_col})\")\n",
    "    plt.xlabel(\"Quarter\")\n",
    "    plt.ylabel(\"Number of postings\")\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    print(f\"Excluded industry: {recruit_label}\")\n",
    "    print(f\"Exposure column used: {exposure_col}\")\n",
    "    print(f\"Treatment date: {treat_dt.date()}\")\n",
    "    print(f\"Pre-treatment OCCUPATION median ({exposure_col}): {median_pre:.4f}\")\n",
    "    print(f\"Unique pre-treatment occupations used for median: {len(occ_pre):,}\")\n",
    "    print(f\"Rows used after filtering & merge: {len(d):,}\")\n",
    "\n",
    "    return plot_df, median_pre"
   ]
  },
