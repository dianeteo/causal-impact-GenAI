   "source": [
    "q_2022Q4 = pd.Period(\"2022Q4\", freq=\"Q\")\n",
    "q_2023Q1 = pd.Period(\"2023Q1\", freq=\"Q\")\n",
    "\n",
    "hr_pivot[\"delta_2023Q1_Q4\"] = (\n",
    "    hr_pivot.get(q_2023Q1, 0) - hr_pivot.get(q_2022Q4, 0)\n",
    ")\n",
    "\n",
    "top_hr_Q1 = (\n",
    "    hr_pivot\n",
    "    .sort_values(\"delta_2023Q1_Q4\", ascending=False)\n",
    "    .head(20)\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "top_hr_Q1_named = top_hr_Q1.merge(\n",
    "    exposure_df[[\"O*NET-SOC Code\", \"Title\"]],\n",
    "    left_on=\"onet_code\",\n",
    "    right_on=\"O*NET-SOC Code\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "top_hr_Q1_named\n"
   ]
  },
