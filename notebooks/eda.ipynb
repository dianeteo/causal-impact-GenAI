   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plot_df = top_hr_Q3_named.sort_values(\"delta_2022Q3_Q2\")\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.barh(plot_df[\"Title\"], plot_df[\"delta_2022Q3_Q2\"])\n",
    "plt.axvline(0, color=\"black\", linewidth=0.8)\n",
    "plt.title(\"HR industry: Job titles driving 2022Q3 spike (Q3 − Q2)\")\n",
    "plt.xlabel(\"Change in unique postings\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
