    "    plt.plot(li[\"q_start\"], li[\"li_no_idx\"], label=\"LinkedIn postings (quarterly, excl. recruitment)\", linewidth=2, linestyle=\"--\")\n",
    "    plt.plot(mom[\"q_start\"], mom[\"mom_idx\"], label=\"MOM job vacancies (quarterly)\", linewidth=2, marker=\"o\")\n",
    "\n",
    "    plt.axhline(100, linestyle=\":\", linewidth=1)\n",
    "    plt.title(f\"Indexed Quarterly Job Demand: LinkedIn vs MOM ({start_qtr}–{end_qtr})\")\n",
