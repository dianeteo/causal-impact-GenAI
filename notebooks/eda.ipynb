   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plot_df = top_firms_spike.sort_values(\"delta_Q3_Q2_2022\")\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.barh(plot_df[\"ultimate_parent_company_name\"], plot_df[\"delta_Q3_Q2_2022\"])\n",
    "plt.axvline(0, color=\"black\", linewidth=0.8)\n",
    "plt.title(\"Top firms driving 2022Q3 spike (Q2 − Q3)\")\n",
    "plt.xlabel(\"Change in unique postings\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
