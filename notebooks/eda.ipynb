  {
   "cell_type": "code",
   "execution_count": 141,
   "id": "e31ba586",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import hashlib\n",
    "\n",
    "\n",
    "def _ensure_content_hash(\n",
    "    df: pd.DataFrame,\n",
    "    hash_cols=None,\n",
    "    hash_colname: str = \"content_hash\"\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Ensure df has a stable 'content_hash' column.\n",
    "    If already present, keep it. Otherwise create from selected columns.\n",
    "    \"\"\"\n",
    "    df = df.copy()\n",
    "\n",
    "    if hash_colname in df.columns and df[hash_colname].notna().any():\n",
    "        return df\n",
    "\n",
    "    if hash_cols is None:\n",
    "        hash_cols = [\n",
    "            \"ultimate_parent_rcid\",\n",
    "            \"ultimate_parent_company_name\",\n",
    "            \"company\",\n",
    "            \"mapped_role\",\n",
    "            \"onet_code\",\n",
    "            \"jobtitle\",\n",
    "            \"title_raw\",\n",
    "            \"title_translated\",\n",
    "            \"location_raw\",\n",
    "            \"remote_type\",\n",
    "            \"description\",\n",
    "            \"salary_min\",\n",
    "            \"salary_max\",\n",
    "            \"salary_predicted\",\n",
    "        ]\n",
    "\n",
    "    hash_cols = [c for c in hash_cols if c in df.columns]\n",
    "    if not hash_cols:\n",
    "        raise ValueError(\"No valid hash columns found in df to build content_hash.\")\n",
    "\n",
    "    def norm(x):\n",
    "        if pd.isna(x):\n",
    "            return \"\"\n",
    "        s = str(x).strip().lower()\n",
    "        return \" \".join(s.split())\n",
    "\n",
    "    def make_hash(row):\n",
    "        s = \"||\".join(norm(v) for v in row.values)\n",
    "        return hashlib.md5(s.encode(\"utf-8\")).hexdigest()\n",
    "\n",
    "    df[hash_colname] = df[hash_cols].apply(make_hash, axis=1)\n",
    "    return df\n",
    "\n",
    "\n",
    "def _dedupe_within_window(\n",
    "    d: pd.DataFrame,\n",
    "    date_col: str,\n",
    "    hash_col: str,\n",
    "    window_days: int = 60,\n",
    "    keep: str = \"first\",\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Rolling-window repost removal:\n",
    "      - For each content_hash, sort by date.\n",
    "      - Split into 'episodes' whenever the gap between consecutive posts > window_days.\n",
    "      - Keep the first (or last) post within each episode.\n",
    "    \"\"\"\n",
    "    if keep not in (\"first\", \"last\"):\n",
    "        raise ValueError(\"keep must be 'first' or 'last'.\")\n",
    "\n",
    "    dd = d.sort_values([hash_col, date_col]).copy()\n",
    "    dd[\"prev_date\"] = dd.groupby(hash_col)[date_col].shift(1)\n",
    "    dd[\"gap_days\"] = (dd[date_col] - dd[\"prev_date\"]).dt.days\n",
    "\n",
    "    dd[\"new_episode\"] = dd[\"prev_date\"].isna() | (dd[\"gap_days\"] > window_days)\n",
    "    dd[\"episode_id\"] = dd.groupby(hash_col)[\"new_episode\"].cumsum()\n",
    "\n",
    "    # Deduplicate within each (hash, episode)\n",
    "    if keep == \"first\":\n",
    "        out = dd.drop_duplicates(subset=[hash_col, \"episode_id\"], keep=\"first\").copy()\n",
    "    else:\n",
    "        out = dd.drop_duplicates(subset=[hash_col, \"episode_id\"], keep=\"last\").copy()\n",
    "\n",
    "    return out.drop(columns=[\"prev_date\", \"gap_days\", \"new_episode\", \"episode_id\"])\n",
    "\n",
    "\n",
    "def plot_reposts_vs_unique_by_year_windowed(\n",
    "    df: pd.DataFrame,\n",
    "    year: int,\n",
    "    date_col: str = \"post_date\",\n",
    "    hash_col: str = \"content_hash\",\n",
    "    hash_cols=None,\n",
    "    window_days: int = 60,\n",
    "    keep: str = \"first\",  # you asked: keep the first within 60-day window\n",
    "    figsize=(10, 4),\n",
    "    title_prefix=\"Job Postings\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Plot two monthly lines for a given year:\n",
    "      1) raw postings (with reposts)\n",
    "      2) unique postings after removing reposts within a rolling window\n",
    "         (same content_hash within `window_days` => keep earliest if keep='first')\n",
    "\n",
    "    Notes:\n",
    "      - This is *not* \"drop all duplicates in the year\". If the same hash reappears\n",
    "        after > window_days, it's treated as a new hiring episode and kept.\n",
    "    \"\"\"\n",
    "    if keep not in (\"first\", \"last\"):\n",
    "        raise ValueError(\"keep must be 'first' or 'last'.\")\n",
    "\n",
    "    d = df.copy()\n",
    "\n",
    "    # Ensure datetime\n",
    "    d[date_col] = pd.to_datetime(d[date_col], errors=\"coerce\")\n",
    "    d = d.dropna(subset=[date_col])\n",
    "\n",
    "    # Filter to year\n",
    "    d = d[d[date_col].dt.year == year].copy()\n",
    "\n",
    "    # Ensure content_hash exists\n",
    "    d = _ensure_content_hash(d, hash_cols=hash_cols, hash_colname=hash_col)\n",
    "\n",
    "    # Month index for full year\n",
    "    all_months = pd.period_range(f\"{year}-01\", f\"{year}-12\", freq=\"M\").to_timestamp()\n",
    "\n",
    "    # Raw postings per month\n",
    "    d[\"month\"] = d[date_col].dt.to_period(\"M\").dt.to_timestamp()\n",
    "    monthly_raw = (\n",
    "        d.groupby(\"month\")\n",
    "         .size()\n",
    "         .reindex(all_months, fill_value=0)\n",
    "         .reset_index(name=\"raw_postings\")\n",
    "         .rename(columns={\"index\": \"month\"})\n",
    "    )\n",
    "\n",
    "    # Windowed unique postings per month\n",
    "    d_unique = _dedupe_within_window(\n",
    "        d,\n",
    "        date_col=date_col,\n",
    "        hash_col=hash_col,\n",
    "        window_days=window_days,\n",
    "        keep=keep,\n",
    "    )\n",
    "    d_unique[\"month\"] = d_unique[date_col].dt.to_period(\"M\").dt.to_timestamp()\n",
    "\n",
    "    monthly_unique = (\n",
    "        d_unique.groupby(\"month\")\n",
    "                .size()\n",
    "                .reindex(all_months, fill_value=0)\n",
    "                .reset_index(name=\"unique_postings\")\n",
    "                .rename(columns={\"index\": \"month\"})\n",
    "    )\n",
    "\n",
    "    # Merge for plotting\n",
    "    plot_df = monthly_raw.merge(monthly_unique, on=\"month\", how=\"left\")\n",
    "    plot_df[\"unique_postings\"] = plot_df[\"unique_postings\"].fillna(0).astype(int)\n",
    "\n",
    "    # Plot\n",
    "    plt.figure(figsize=figsize)\n",
    "    plt.plot(plot_df[\"month\"], plot_df[\"raw_postings\"],\n",
    "             marker=\"o\", linestyle=\"--\", label=\"Raw postings (with reposts)\")\n",
    "    plt.plot(plot_df[\"month\"], plot_df[\"unique_postings\"],\n",
    "             marker=\"o\", label=f\"Unique postings (deduped within {window_days}d; keep={keep})\")\n",
    "\n",
    "    plt.title(f\"{title_prefix} in {year}: Raw vs Window-Deduped Unique Postings\")\n",
    "    plt.xlabel(\"Month\")\n",
    "    plt.ylabel(\"Number of postings\")\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    return plot_df"
   ]
  },
