    "\n",
    "def plot_linkedin_quarterly_vs_mom_indexed(\n",
    "    d_unique: pd.DataFrame,\n",
    "    mom_path: str,\n",
    "    date_col: str = \"post_date\",\n",
    "    industry_col: str = \"rics_k400\",\n",
    "    recruit_label: str = \"Recruitment and Staffing Services\",\n",
    "    mom_quarter_col: str = \"quarter\",\n",
    "    mom_vacancy_col: str = \"job_vacancy\",\n",
    "    start_qtr: str = \"2022Q1\",\n",
    "    end_qtr: str = \"2024Q4\",\n",
    "    figsize=(11, 4.5),\n",
    "):\n",
    "    \"\"\"\n",
    "    Single-axis indexed line plot (quarterly):\n",
    "      - LinkedIn quarterly postings (All vs Excl recruitment)\n",
    "      - MOM quarterly vacancies\n",
    "    All indexed to 100 at start_qtr for easy trend comparison.\n",
    "    \"\"\"\n",
    "\n",
    "    start_p = pd.Period(start_qtr, freq=\"Q\")\n",
    "    end_p = pd.Period(end_qtr, freq=\"Q\")\n",
    "\n",
    "    # -----------------------------\n",
    "    # A) LinkedIn -> quarterly counts\n",
    "    # -----------------------------\n",
    "    d = d_unique.copy()\n",
    "    d[date_col] = pd.to_datetime(d[date_col], errors=\"coerce\")\n",
    "    d = d.dropna(subset=[date_col]).copy()\n",
    "\n",
    "    d[\"q_period\"] = d[date_col].dt.to_period(\"Q\")\n",
    "    d = d[(d[\"q_period\"] >= start_p) & (d[\"q_period\"] <= end_p)].copy()\n",
    "\n",
    "    # all postings\n",
    "    li_all = (\n",
    "        d.groupby(\"q_period\")\n",
    "         .size()\n",
    "         .reset_index(name=\"li_all\")\n",
    "         .sort_values(\"q_period\")\n",
    "    )\n",
    "\n",
    "    # excluding recruitment industry\n",
    "    d_no_recruit = d[d[industry_col] != recruit_label].copy()\n",
    "    li_no_recruit = (\n",
    "        d_no_recruit.groupby(\"q_period\")\n",
    "                   .size()\n",
    "                   .reset_index(name=\"li_no_recruit\")\n",
    "                   .sort_values(\"q_period\")\n",
    "    )\n",
    "\n",
    "    li = li_all.merge(li_no_recruit, on=\"q_period\", how=\"left\").fillna(0)\n",
    "    li[\"q_start\"] = li[\"q_period\"].dt.start_time\n",
    "\n",
    "    # index both LinkedIn series to 100 at start_qtr\n",
    "    base_all = li.loc[li[\"q_period\"] == start_p, \"li_all\"].iloc[0]\n",
    "    base_no = li.loc[li[\"q_period\"] == start_p, \"li_no_recruit\"].iloc[0]\n",
    "    li[\"li_all_idx\"] = 100 * li[\"li_all\"] / base_all if base_all != 0 else 0\n",
    "    li[\"li_no_idx\"] = 100 * li[\"li_no_recruit\"] / base_no if base_no != 0 else 0\n",
    "\n",
    "    # -----------------------------\n",
    "    # B) MOM quarterly vacancies\n",
    "    # -----------------------------\n",
    "    mom = pd.read_csv(mom_path)\n",
    "    mom = mom.rename(columns={c: c.strip().lower() for c in mom.columns})\n",
    "\n",
    "    qcol = mom_quarter_col.lower()\n",
    "    vcol = mom_vacancy_col.lower()\n",
    "\n",
    "    mom[qcol] = mom[qcol].astype(str).str.strip().str.replace(\"-\", \"\", regex=False)\n",
    "    mom[\"q_period\"] = pd.PeriodIndex(mom[qcol], freq=\"Q\")\n",
    "    mom[vcol] = pd.to_numeric(mom[vcol], errors=\"coerce\")\n",
    "\n",
    "    mom = mom.dropna(subset=[vcol]).copy()\n",
    "    mom = mom[(mom[\"q_period\"] >= start_p) & (mom[\"q_period\"] <= end_p)].copy()\n",
    "    mom = mom.sort_values(\"q_period\")\n",
    "    mom[\"q_start\"] = mom[\"q_period\"].dt.start_time\n",
    "\n",
    "    base_mom = mom.loc[mom[\"q_period\"] == start_p, vcol].iloc[0]\n",
    "    mom[\"mom_idx\"] = 100 * mom[vcol] / base_mom if base_mom != 0 else 0\n",
    "\n",
    "    # -----------------------------\n",
    "    # C) Plot\n",
    "    # -----------------------------\n",
    "    plt.figure(figsize=figsize)\n",
    "\n",
